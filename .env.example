# ==============================================================================
# VÉRSE - VARIÁVEIS DE AMBIENTE (.env.example)
# NUNCA insira credenciais reais neste arquivo. Copie para .env.local para uso local.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Banco de Dados, Autenticação e Storage)
# Obtenha em: https://supabase.com -> Seu Projeto -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_chave_publica_anonima_respeita_rls

# Chave com privilégios administrativos. OBRIGATORIAMENTE PRIVADA NO SERVIDOR.
# NUNCA exponha esta chave ou a utilize em arquivos acessíveis pelo navegador.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.exemplo_chave_service_role_privada_apenas_backend

# ------------------------------------------------------------------------------
# 2. IDENTIDADE DA APLICAÇÃO & URLs
# ------------------------------------------------------------------------------
NEXT_PUBLIC_APP_NAME="VÉRSE"
NEXT_PUBLIC_APP_TAGLINE="A sua rede social livre, privada e com inteligência artificial ética."
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. PROVEDOR DE IA (Fase 5 - Cota Gratuita)
# Exemplos suportados: 'cloudflare', 'groq', 'disabled'
# ------------------------------------------------------------------------------
AI_PROVIDER="disabled"
AI_API_KEY=""
AI_ENDPOINT=""
AI_MODEL_NAME="llama-3-8b-instruct"
AI_DAILY_USER_LIMIT=10

# ------------------------------------------------------------------------------
# 4. SEGURANÇA E RATE LIMITING
# ------------------------------------------------------------------------------
RATE_LIMIT_MAX_REQUESTS_PER_MINUTE=60
